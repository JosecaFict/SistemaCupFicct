APP_NAME="Sistema CUP FICCT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== PostgreSQL =====
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistema_cup
DB_USERNAME=postgres
DB_PASSWORD=mi_password

# ===== Sesiones / Cache / Cola =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ===== Sanctum (SPA stateful) =====
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# ===== CORS / Frontend =====
FRONTEND_URL=http://localhost:5173

# ===== Mail (recuperacion de contrasena) =====
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cup-ficct.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Stripe (Ciclo 1 = simulado) =====
# STRIPE_MODE: simulated | test | live
# En Ciclo 1 dejar 'simulated'. Para usar Stripe Test real cambiar a 'test' y llenar las claves.
STRIPE_MODE=simulated
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ===== Codigo de postulante =====
CODIGO_POSTULANTE_LENGTH=7

VITE_APP_NAME="${APP_NAME}"
