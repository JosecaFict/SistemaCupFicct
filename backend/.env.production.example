# ==========================================================================
# .env de PRODUCCION - Sistema CUP FICCT (Railway / Vercel)
# --------------------------------------------------------------------------
# Plantilla con las variables que hay que configurar en Railway.
# NO commitear el .env real con secretos.
# ==========================================================================

APP_NAME="Sistema CUP FICCT"
APP_ENV=production
APP_KEY=                              # Generar con: php artisan key:generate --show
APP_DEBUG=false                       # OBLIGATORIO false en produccion
APP_TIMEZONE=America/La_Paz
APP_URL=https://sistema-cup-ficct.up.railway.app   # URL Railway del backend

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                     # warning en produccion (menos ruido)

# ===== PostgreSQL (Railway lo provee como DATABASE_URL) =====
# Railway expone DATABASE_URL automaticamente cuando se conecta el plugin
# de PostgreSQL. Laravel 11 lo entiende directamente.
DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:pass@host:port/dbname   (Railway lo inyecta)

# ===== Sesiones =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true                  # en produccion: true
SESSION_PATH=/
SESSION_DOMAIN=.up.railway.app        # ajustar al dominio real
SESSION_SECURE_COOKIE=true            # HTTPS only en produccion
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ===== Sanctum (SPA stateful) =====
# CSV de dominios autorizados a usar cookies de sesion.
# Incluir el dominio del frontend en Vercel.
SANCTUM_STATEFUL_DOMAINS=sistema-cup-ficct.vercel.app

# ===== CORS / Frontend =====
FRONTEND_URL=https://sistema-cup-ficct.vercel.app

# ===== Mail (opcional, queda con 'log' si no se configura) =====
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cup-ficct.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Stripe (simulado por ahora) =====
STRIPE_MODE=simulated
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ===== Codigo de postulante =====
CODIGO_POSTULANTE_LENGTH=7

VITE_APP_NAME="${APP_NAME}"
